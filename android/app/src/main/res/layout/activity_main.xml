<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RABBIT // PROTOCOL"
                android:textColor="@color/cyan_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rabbit_tagline"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_cyan"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="ONLINE"
            android:textColor="@color/cyan_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:tint="@color/text_dim"
            android:src="@android:drawable/ic_menu_preferences" />
    </LinearLayout>

    <!-- Center Arc-Reactor Core -->
    <FrameLayout
        android:id="@+id/reactorContainer"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/dialogueCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer Glow Ring -->
        <View
            android:id="@+id/viewOuterRing"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <!-- Middle Dotted Ring -->
        <View
            android:id="@+id/viewMiddleRing"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_middle" />

        <!-- Central Arc Reactor Core Button -->
        <FrameLayout
            android:id="@+id/btnArcReactor"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_reactor_core"
            android:elevation="8dp">

            <TextView
                android:id="@+id/tvCoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="RABBIT"
                android:textColor="#050B14"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </FrameLayout>
    </FrameLayout>

    <!-- Dialogue & Bengali Text Box -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dialogueCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/cyan_glow"
        app:layout_constraintBottom_toTopOf="@id/quickActionsScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvStateLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VOICE TELEMETRY"
                    android:textColor="@color/cyan_primary"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_gold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="ACTION READY"
                    android:visibility="gone"
                    android:textColor="@color/gold_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDialogueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="45dp"
                android:text="আসসালামু আলাইকুম ইমন স্যার! আমি র্যাবিট। আমি প্রস্তুত।"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Action Chips -->
    <HorizontalScrollView
        android:id="@+id/quickActionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/inputBarLayout">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipTorch"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="টর্চ অন/অফ"
                android:textColor="@color/cyan_primary"
                app:strokeColor="@color/cyan_primary" />

            <Button
                android:id="@+id/chipBattery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="ব্যাটারি লেভেল"
                android:textColor="@color/cyan_primary"
                app:strokeColor="@color/cyan_primary" />

            <Button
                android:id="@+id/chipUpdate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="আপডেট চেক"
                android:textColor="@color/gold_accent"
                app:strokeColor="@color/gold_accent" />

            <Button
                android:id="@+id/chipServer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="সার্ভার স্ট্যাটাস"
                android:textColor="@color/cyan_primary"
                app:strokeColor="@color/cyan_primary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/inputBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etUserMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_box"
            android:hint="বাংলায় লিখুন অথবা কোরে ট্যাপ করুন..."
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_white"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnSendText"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_cyan"
            android:contentDescription="Send"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#050B14" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
